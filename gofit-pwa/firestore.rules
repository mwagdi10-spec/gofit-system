rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return userDoc().data.role;
    }

    function identifier() {
      return userDoc().data.identifier;
    }

    function isTrainer() {
      return signedIn() && role() in ['owner', 'trainer'];
    }

    function isClient(identifierValue) {
      return signedIn() && (
        (role() == 'client' && identifier() == identifierValue) ||
        request.auth.token.firebase.sign_in_provider == 'anonymous'
      );
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isTrainer());
      allow create, update, delete: if isTrainer();
    }

    match /artifacts/{appId}/public/data/client_names/{clientId} {
      allow read: if isTrainer() || isClient(clientId);
      allow create, update: if isTrainer();
      allow delete: if isTrainer();
    }

    match /artifacts/{appId}/public/data/workouts/{workoutId} {
      allow read: if isTrainer() || isClient(resource.data.assignedTo);
      allow create, update, delete: if isTrainer();
    }

    match /artifacts/{appId}/public/data/logs/{logId} {
      allow read: if isTrainer() || isClient(resource.data.clientName);
      allow create: if isTrainer() || isClient(request.resource.data.clientName);
      allow update, delete: if isTrainer();
    }

    match /artifacts/{appId}/public/data/user_notes/{noteId} {
      allow read: if isTrainer() || isClient(resource.data.clientName);
      allow create: if isTrainer() || isClient(request.resource.data.clientName);
      allow update, delete: if isTrainer();
    }

    match /artifacts/{appId}/public/data/library/{exerciseId} {
      allow read: if signedIn();
      allow create, update, delete: if isTrainer();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
